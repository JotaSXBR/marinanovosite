# deps
node_modules/
__pycache__/

# build de deploy (gerado pela Action)
deploy/

# pacote de entrega ao dev (artefato local, igual ao deploy/ — não versionar)
entrega-site/
entrega-site.zip

# espelho wget do WordPress antigo (15 MB, 119 arquivos). Saiu do repo em
# 14/10/2026 porque so serve de referencia e a pasta de trabalho nao precisa
