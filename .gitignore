#   git checkout 727727c -- site-original/
# A Action de deploy nunca leu esta pasta, entao retirar nao afeta o site.

# backup do WordPress antigo (109 MB, contem wp-config.php com credenciais).
# NUNCA versionar; guardar fora do repo.
cgi-bin.zip

# testes
tests/test-results/
tests/playwright-report/

# logs e SO
*.log
.DS_Store
Thumbs.db

# temporarios de planilha (Excel cria ~$arquivo.xlsx ao abrir)
~$*.xlsx

# dados de RUNTIME do painel — criados em uso, nunca versionar.
# Só o .htaccess (que bloqueia o acesso) é versionado; o conteudo é da dona.
nova-landing/private/dados/*
!nova-landing/private/dados/.htaccess

