# Painel da proprietária.
#
# Só o index.php responde por URL. Qualquer OUTRO .php desta pasta (apoio.php,
# config.php) é include interno e não pode ser aberto pelo navegador.
# partes/ tem o próprio .htaccess negando a pasta inteira.
<FilesMatch "^(?!index\.php$).*\.php$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_authz_core.c>
  Header set X-Robots-Tag "noindex, nofollow"
  Options -Indexes
</IfModule>

# Cache do painel: o PHP JA manda no-store por causa da sessao (o
# session.cache_limiter padrao). Sem este bloco, o .htaccess da raiz
# acrescentava um segundo Cache-Control (private, no-cache) e a resposta saia
# com dois cabecalhos conflitantes. Aqui o do painel substitui o herdado.
#
# no-store (e nao so no-cache) porque o painel tem dado de negocio: carrinhos,
# precos e links. Um proxy que ignora 'private' nao pode guardar nada disso.
#
# POR QUE ESTE BLOCO USA <FilesMatch> E NAO UM Header SOLTO (medido):
# o mod_headers aplica os contextos nesta ordem — servidor, <Directory>,
# .htaccess, <Directory> do filho, .htaccess do filho e SO ENTao
# <Files>/<FilesMatch>. O <FilesMatch "\.(html|php)$"> do .htaccess da RAIZ e o
# ultimo da fila e vencia um `Header set` solto aqui dentro: o painel continuava
# devolvendo `private, no-cache` do pai. Dentro de <FilesMatch>, o do filho roda
# depois do do pai e ganha. NAO remover o <FilesMatch> daqui.
<IfModule mod_headers.c>
  <FilesMatch "\.php$">
    Header set Cache-Control "no-store, no-cache, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "Thu, 19 Nov 1981 08:52:00 GMT"
  </FilesMatch>
</IfModule>