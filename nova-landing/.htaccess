# Pilates em Casa
# Principal dinâmico: index.php resolve a oferta no servidor (?o=CODIGO).
DirectoryIndex index.php index.html

# ---------------------------------------------------------------- CACHE
# MEDIDO em produção (14/10/2026): as diretivas ExpiresByType daqui NAO tinham
# efeito nenhum — nenhuma imagem voltava com Cache-Control nem Expires, e o
# browser caia em cache heurístico (10% da idade do arquivo), que é
# imprevisível: uma imagem de hoje não é cacheada, uma de um ano fica 36 dias.
# A causa é mod_expires não estar ativo nesse Apache. O que FUNCIONA é
# mod_headers — o `Header set` do bloco ?o= abaixo volta correto em produção.
# Por isso todo o cache aqui é escrito com mod_headers.
#
# REGRA OPERACIONAL (importante): trocar uma imagem = MUDAR O NOME DO ARQUIVO.
# Com `immutable` por 1 ano, sobrescrever mantendo o nome deixa a versão velha
# presa no cache de quem já visitou. Foi o que fizemos com o hero:
# nath-hero-b3 -> nath-hero-v2.
<IfModule mod_headers.c>
  # Estáticos: 1 ano, imutável. São 28 imagens / 3,9 MB só na home; sem isso
  # tudo baixa de novo a cada visita. `immutable` dispensa revalidação.
  <FilesMatch "\.(webp|png|jpe?g|svg|woff2|woff|avif|css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # HTML/PHP: guarda, mas sempre revalida. O preço aparece na landing e uma
  # cópia velha em cache mostraria um valor que a pessoa não vai pagar — por
  # isso `no-cache` (nunca max-age grande). `private` bloqueia cache
  # compartilhado (proxy/CDN), que não deve guardar página com oferta.
  # Ainda permite voltar pelo botão do navegador, ao contrário de no-store.
  <FilesMatch "\.(html|php)$">
    Header set Cache-Control "private, no-cache"
  </FilesMatch>

  Header unset ETag
</IfModule>

# Oferta é resolvida no servidor: nunca cachear o HTML com ?o= (evita
# entregar preço de um visitante no cache para outro).
<IfModule mod_headers.c>
  <If "%{QUERY_STRING} =~ /o=/">
    Header set Cache-Control "private, no-store"
  </If>
</IfModule>

# Defesa em profundidade: se a pasta private/ for alcançada, negar PHP nela
# (o private/.htaccess já nega tudo; isto cobre o caso de AllowOverride off).
<FilesMatch "(^|/)(ofertas|rastreio|carrinhos|config|apoio)\.php$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>

# ---------------------------------------------------------------- segurança
# Headers de hardening (recomendação OWASP). Todos dentro de um bloco
# IfModule mod_headers porque exigem AllowOverride FileInfo; se a host não
# permitir, o site continua funcionando normal — só fica sem esses headers.
<IfModule mod_headers.c>
  # Impede o navegador "adivinhar" o tipo do arquivo (ex.: servir .jpg como
  # HTML e executar XSS).
  Header always set X-Content-Type-Options "nosniff"

  # Proíbe o painel de ser embutido em iframe de outro site (clickjacking:
  # alguém coloca uma camada invisível sobre o botão de Apagar).
  Header always set X-Frame-Options "SAMEORIGIN"

  # Vazamento de URL: ao sair para o WhatsApp/Kiwify, manda só a origem, sem
  # os parâmetros ?src= / ?o= do canal.
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # APIs que o site não usa: desliga explicitamente.
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"

  # Força HTTPS por 6 meses. SEM includeSubDomains/preload de propósito: se o
  # SSL do subdomínio algum dia falhar, o browser ficaria preso em HTTPS sem
  # saída. Para remover: apague esta linha e faça um request vazio.
  Header always set Strict-Transport-Security "max-age=15552000"

  # NÃO definir X-Robots-Tag aqui: a oferta secreta manda `noindex` pelo PHP
  # e o painel define no painel/.htaccess. Um "set" no raiz sobrescreveria os
  # dois e a página secreta voltaria a ser indexada.
</IfModule>

# ------------------------------------------------------------------ HTTPS
# O site aceitava http:// e devolvia 200 em vez de jogar para https://. Como o
# form de login do painel não tem action (submete para a URL atual), uma 1ª
# visita por http mandava a senha da proprietária em claro.
#
# No cPanel o nginx fica na frente do Apache, então o Apache pode ver a conexão
# interna em http mesmo quando o visitante chegou por https — daí o
# X-Forwarded-Proto. Redireciona só quando NENHUM dos dois sinais diz https,
# o que evita loop.
#
# Destino com host FIXO de propósito: usar %{HTTP_HOST} transformaria isto em
# open redirect (basta mandar "Host: evil.com" e o servidor obedeceria). Como
# www responde igual, normalizo para o canônico sem www.
<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !^https$
  RewriteCond %{HTTP_HOST} ^www\.maricoachfit\.com$ [NC]
  RewriteRule ^ https://maricoachfit.com%{REQUEST_URI} [R=301,L]

  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !^https$
  RewriteCond %{HTTP_HOST} ^maricoachfit\.com$ [NC]
  RewriteRule ^ https://maricoachfit.com%{REQUEST_URI} [R=301,L]
</IfModule>

# Nada de CSP aqui ainda: a landing usa CSS e JS inline (por escolha, sem
# build) e o painel usa onclick inline. Uma CSP estrita exigiria nonce, que só
# dá para gerar em build — não temos. Fica registrado o que falta.

# Nada de listar o conteúdo das pastas por URL.
<IfModule mod_autoindex.c>
  Options -Indexes
</IfModule>

# Arquivos que nunca devem ser servidos (dump de banco, log, backup, config).
<FilesMatch "\.(?i:log|sql|bak|old|orig|swp|save|ini|sh|inc|md5|sha1|jsonl)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
</FilesMatch>

# Arquivos ocultos (.~lock, .git, .env) nunca sao servidos.
<FilesMatch "^\.">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
</FilesMatch>
